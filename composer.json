{
  "name": "cherynes/restaurant-app",
  "description": "Cheryne's restaurant ordering, reservations, payments, and admin web app.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "stripe/stripe-php": "^20.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "test": "php ./vendor/bin/phpunit --configuration phpunit.xml",
    "serve": "php -S localhost:3000 -t public router.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
