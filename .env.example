# --- Application Environment ---
APP_NAME="Cheryne's"
APP_ENV=local
APP_DEBUG=false
APP_URL=https://cherynes.example
APP_TIMEZONE=Africa/Nairobi

# Generate locally with: openssl rand -hex 16
ENCRYPTION_KEY=

# --- Secure PostgreSQL Connection ---
DB_DSN=pgsql:host=localhost;port=5432;dbname=cherynes
DB_USER=your_secure_postgres_username
DB_PASS=your_strong_postgres_password

# --- Cleaned & Generative Session Setup ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_TIMEOUT=1800
SESSION_ABSOLUTE_LIMIT=14400

# --- Password reset email ---
MAIL_ENABLED=false
MAIL_FROM=no-reply@cherynes.example

# --- Payment Gateways (Keep Secrets Empty Until Production) ---
STRIPE_SECRET=
STRIPE_PUBLISHABLE=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-domain.example/webhooks/mpesa
MPESA_SANDBOX=true
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# --- Third-Party Integrations ---
GOOGLE_MAPS_API_KEY=

# --- System Admin Setup ---
ADMIN_EMAIL=admin@cherynes.com
# DO NOT STORE PLAIN TEXT ADMIN PASSWORDS HERE